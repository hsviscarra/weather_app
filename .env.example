# Copy this file to .env for local development.
# In production on Databricks Apps, LAKEBASE_URL is resolved from the
# "database/lakebase-url" secret via lakebase.py + app.yaml - do NOT put a
# real secret value in this file or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# NWS requires a descriptive User-Agent identifying your app + contact info.
NWS_USER_AGENT=(weather_app, you@example.com)

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
